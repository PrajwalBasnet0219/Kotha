{"name": "@kotha/shared", "version": "1.0.0", "private": true, "description": "The blueprint contract, validation schemas and geometry maths shared by the client and the API.", "main": "./dist/cjs/index.js", "module": "./dist/esm/index.js", "types": "./dist/cjs/index.d.ts", "exports": {".": {"types": "./dist/cjs/index.d.ts", "import": "./dist/esm/index.js", "require": "./dist/cjs/index.js"}}, "files": ["dist"], "scripts": {"build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node ./scripts/fixup.js", "typecheck": "tsc -p tsconfig.cjs.json --noEmit", "clean": "rm -rf dist"}, "dependencies": {"zod": "^3.24.1"}, "devDependencies": {"typescript": "^5.6.3"}}